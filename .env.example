# 로컬 개발 전용 백엔드 주소. Next 프록시(src/app/api/v1)가 /api/v1 요청을 여기로 넘긴다 (서버 전용)
API_PROXY_TARGET=https://dev.api.pabom.app
# 브라우저가 부르는 백엔드 주소. 개발·운영 서버 배포에서는 꼭 넣는다 (예: https://dev.api.pabom.app)
# 로컬과 데모 서버에서는 비운다 (로컬은 프록시로, 데모는 전부 목업으로)
NEXT_PUBLIC_API_BASE_URL=
# 백엔드에 아직 없는 API를 MSW로 가짜로 만든다 (enabled | disabled). 배포에서도 동작한다
NEXT_PUBLIC_API_MOCKING=enabled
# 목업 모드에서도 진짜 백엔드로 보낼 API 묶음 (쉼표로). auth = 로그인·약관 동의, species = 종·모프 조회,
# pets = 개체 목록·등록·상세·수정 (auth와 같이. 사진·체크 리스트는 아직 목업이라 사진 칸을 숨기고 등록 뒤 상세로 간다).
# 데모 서버는 비운다
NEXT_PUBLIC_API_LIVE=auth,species
# 웹 푸시용 VAPID 공개키
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
